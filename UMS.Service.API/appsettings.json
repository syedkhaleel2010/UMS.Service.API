{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}",
          "shared": true
        }
      },
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "Server=KPDCSVDB105-QAT,50100;Database=MarineNotMgmtQA; User Id=marinenot.q;Password=ghDrHHhE0G@DKDe;MultipleActiveResultSets=true;TrustServerCertificate=True",
          "sinkOptionsSection": {
            "tableName": "UMS_LOGS",
            "schemaName": "dbo",
            "autoCreateSqlTable": true,
            "batchPostingLimit": 1
          },
          "restrictedToMinimumLevel": "Error"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "UMS.Service.API"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "N5p$W8xZ3q!Lk9@T1r#Hf4Vg7Yc2Jd6B0uEwQpRzXsMdCbVt",
    "Issuer": "UMS.Service.API",
    "Audience": "UMS.Service.API",
    "ExpirationInMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=KPDCSVDB105-QAT,50100;Database=MarineNotMgmtQA; User Id=marinenot.q;Password=ghDrHHhE0G@DKDe;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "NoOfLoginAttemptsAllowed": 3,
  "PasswordReuseLimit": 5
}
